PORT=5000

# Local MongoDB. If you use MongoDB Atlas, paste your Atlas connection string here instead.
MONGO_URI=mongodb://127.0.0.1:27017/nodemailer-demo

# The Gmail account that SENDS (and receives) the emails
EMAIL_USER=yourname@gmail.com

# A Gmail "App Password" (16 letters) - NOT your normal Gmail password
EMAIL_PASS=abcdefghijklmnop

# Cloudinary (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Any long random string - used to sign login tokens (JWT)
JWT_SECRET=change_me_to_a_long_random_string

# Where the React app runs - used to build the "reset password" link in the email
CLIENT_URL=http://localhost:5173
